# ============================================
# J.A.R.V.I.S Environment Variables
# Copy to .env and fill in values
# ============================================

# Ollama (local, no API key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Telegram Bot (get free token from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_user_id

# Cognee (local storage paths — all inside J.A.R.V.I.S/)
COGNEE_DB_PATH=./data/cognee_db
COGNEE_VECTOR_DB=lancedb

# Security
JARVIS_SECURITY_DIR=./security
JARVIS_LOG_DIR=./logs

# Claw Brain (Submodule)
CLAW_PATH=/usr/local/bin/claw  # Windows: C:\path\to\claw.exe
CLAW_MODEL=openai/minimaxm2.7:cloud
CLAW_PERMISSION_MODE=workspace-write

# Learning Schedule (cron expressions — IST night)
LEARNING_CRON=30 19 * * *
# SMTP / Email Notifications (Gmail Recommended)
# IMPORTANT: For Gmail, use a 16-character 'App Password', NOT your main password.
# Generate it here: https://myaccount.google.com/apppasswords
JARVIS_EMAIL_ENABLED=true
NOTIFY_EMAIL_RECIPIENT=your-email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Proactive Mind Loop Settings
JARVIS_MIND_INTERVAL=600  # Seconds between autonomous checks
JARVIS_IGNORE_GIT_PROJECTS=insights360-source  # Comma-separated list of projects to ignore for Git alerts
JARVIS_HOST_NAME=Rudrapratap
